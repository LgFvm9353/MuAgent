DATABASE_URL=mysql+asyncmy://root:root@localhost:3306/agent?charset=utf8mb4
TEST_DATABASE_URL=mysql+asyncmy://root:root@localhost:3306/agent_test?charset=utf8mb4
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api-slb.krill-ai.com/codex/v1
OPENAI_MODEL=gpt-5.6-sol
# Specialist models used by the three visible team members.
ARCHITECT_MODEL=gpt-5.6-sol
REVIEWER_MODEL=gpt-5.4
DESIGNER_MODEL=gpt-5.5
# Empty value uses the active provider default.
VERIFIER_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
WORKSPACE_ROOT=data/workspaces
ARTIFACTS_ROOT=data/artifacts
MODEL_CONCURRENCY=4
MODEL_TIMEOUT_SECONDS=600
# Synchronous rolling context compression. Uses the active model gateway credentials.
CONTEXT_COMPRESSION_MODEL=
CONTEXT_COMPRESSION_MODEL_CONTEXT_WINDOW=1000000
CONTEXT_COMPRESSION_MODEL_MAX_OUTPUT_TOKENS=8192
CONTEXT_COMPRESSION_THRESHOLD=0.85
CONTEXT_COMPRESSION_TARGET=0.60
CONTEXT_SAFETY_MARGIN_RATIO=0.02
CONTEXT_UNKNOWN_MODEL_WINDOW=128000
CONTEXT_UNKNOWN_MODEL_MAX_OUTPUT_TOKENS=8192
# Comma-separated model=token overrides for private/provider-specific model names.
CONTEXT_MODEL_WINDOWS=gpt-5.6-sol=1000000
CONTEXT_MODEL_MAX_OUTPUT_TOKENS=gpt-5.6-sol=128000
CONTEXT_RECENT_MESSAGES=12
# Three-layer long-term memory. Uses MySQL and local Git/files only.
MEMORY_ENABLED=false
MEMORY_HARD_ENABLED=true
MEMORY_ENVIRONMENT_ENABLED=true
MEMORY_EPISODIC_ENABLED=true
MEMORY_AUTO_CONSOLIDATION_ENABLED=false
MEMORY_DEFAULT_OWNER_ID=local-user
MEMORY_MAX_CONTEXT_ITEMS=5
MEMORY_MAX_CONTEXT_TOKENS=8000
MEMORY_MIN_RETRIEVAL_SCORE=0.35
MEMORY_CONSOLIDATION_MAX_ATTEMPTS=3
MEMORY_RETENTION_DAYS=365
MEMORY_ENVIRONMENT_MAX_FILE_BYTES=262144
TOOL_TIMEOUT_SECONDS=120
# Collaboration defaults: parallel agents are independent; handoff is serial-only.
COLLABORATION_DEFAULT_MODE=parallel
COLLABORATION_DEFAULT_SYNTHESIZE=false
COLLABORATION_MAX_AGENTS=3
COLLABORATION_MAX_HANDOFF_DEPTH=1
COLLABORATION_MAX_TOOL_ROUNDS_PER_AGENT=6
COLLABORATION_MAX_TOOL_CALLS_PER_AGENT=10
COLLABORATION_MAX_TOOL_CALLS_PER_TURN=20
COLLABORATION_FIRST_EVENT_WARNING_SECONDS=10
COLLABORATION_IDLE_WARNING_SECONDS=15
COLLABORATION_IDLE_STALL_SECONDS=45
COLLABORATION_TOOL_IDLE_STALL_SECONDS=90
COLLABORATION_INACTIVITY_BUDGET_SECONDS=120
COLLABORATION_AGENT_HARD_TIMEOUT_SECONDS=300
COLLABORATION_HANDOFF_HARD_TIMEOUT_SECONDS=180
COLLABORATION_SYNTHESIS_IDLE_STALL_SECONDS=30
COLLABORATION_SYNTHESIS_HARD_TIMEOUT_SECONDS=120
COLLABORATION_TURN_HARD_TIMEOUT_SECONDS=480
COLLABORATION_CONFIRMATION_TTL_SECONDS=1800
SKILLS_ROOT=skills
MCP_CONFIG_PATH=config/mcp_servers.yaml
MCP_CONNECT_TIMEOUT_SECONDS=15
MCP_READ_TOOL_TIMEOUT_SECONDS=30
MCP_TOOL_TIMEOUT_SECONDS=60
MCP_CLOSE_TIMEOUT_SECONDS=0.5
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SSE_POLL_INTERVAL_SECONDS=1
SSE_HEARTBEAT_SECONDS=15
LOG_LEVEL=INFO

## 启动命令
py -m uv run uvicorn app.main:app --host 127.0.0.1 --port 8000